# SDP stays server-side. Use a project key whose environment matches
# SOLANA_CLUSTER: sandbox for devnet, production for mainnet-beta.
SDP_API_BASE_URL=http://127.0.0.1:8787
SDP_API_KEY=sk_test_replace_me

# Required. Protects the entire app and its signing routes with HTTP Basic auth.
DEMO_ACCESS_USERNAME=northstar
DEMO_ACCESS_PASSWORD=replace_with_a_long_random_password

# Base58 or a JSON array containing one 64-byte Solana keypair. This is the
# demo customer's wallet: its token balance is "checking".
DEMO_WALLET_PRIVATE_KEY=replace_me

# Optional. When set to a different funded keypair on SOLANA_CLUSTER, Northstar pays
# network fees and account rent and co-signs each transaction.
# DEMO_FEE_PAYER_PRIVATE_KEY=replace_me

# Optional. Pin the Embedded Yield strategy behind "savings" to one catalogue
# id. Otherwise Northstar takes the first strategy on SOLANA_CLUSTER that is
# DeFi, instant-liquidity, and USDC, and every page load fails until one exists.
# DEMO_STRATEGY_ID=replace_me

# The RPC must serve this exact cluster; the app verifies its genesis hash.
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
