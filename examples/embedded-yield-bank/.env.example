# SDP stays server-side. Use a sandbox project key with earn:read and earn:write.
SDP_API_BASE_URL=http://127.0.0.1:8787
SDP_API_KEY=sk_test_replace_me

# Base58 or a JSON array containing one 64-byte Solana keypair.
DEMO_WALLET_PRIVATE_KEY=replace_me

# The bank reads this wallet's SOL and strategy-token balances directly on chain.
SOLANA_RPC_URL=https://api.devnet.solana.com

# The Vite app proxies /api here. Change both this and vite.config.ts together.
DEMO_API_PORT=4174
