# Security settings
registry=https://registry.npmjs.org/
audit=true
save-exact=true

# Auth for the private @vedatech scope (`@vedatech/svm-sdk`, owned by
# packages/sdp-veda). This is an ENV REFERENCE, expanded at install time — the
# literal token must never be written here, because this file is committed.
#
# Provide NPM_TOKEN from a read-only, scope-granular token:
#   local  — an env file outside the repo, injected into the build/install
#            container (`--env-file`), never exported into a shell that logs
#   CI     — the `NPM_TOKEN` repository secret
#   images — a BuildKit secret mount (apps/sdp-api/Dockerfile), never an ARG or
#            ENV, which would persist the value in a published layer
#
# Unset is a supported state: every OTHER package here is public, and pnpm can
# install the whole workspace minus `@sdp/veda` with no credential at all
# (`pnpm install --frozen-lockfile --filter '!@sdp/veda'`), which is what a
# forked pull request runs.
//registry.npmjs.org/:_authToken=${NPM_TOKEN}
