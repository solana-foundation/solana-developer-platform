# ─── Solana Developer Platform — local compose ───────────────────────────────
# Copy to .env and fill in the values marked REQUIRED.
# See apps/sdp-api/docs/self-hosting/clerk-setup.md for Clerk walkthrough.

# ─── Host ports ───────────────────────────────────────────────────────────────
SDP_POSTGRES_PORT=5432
SDP_REDIS_PORT=6379
SDP_API_PORT=8787
SDP_WEB_PORT=3000
SDP_DOCS_PORT=3001

# ─── Core runtime ────────────────────────────────────────────────────────────
ENVIRONMENT=development
API_VERSION=local-compose

# self_hosted disables managed-tier enforcement so every configured provider is
# available regardless of the organization's tier.
SDP_DEPLOYMENT_MODE=self_hosted

# ─── Public URLs (browser-facing) ────────────────────────────────────────────
# Base origins (scheme + host[:port]), no trailing slash.
NEXT_PUBLIC_SDP_API_BASE_URL=http://localhost:8787
NEXT_PUBLIC_SDP_API_URL=http://localhost:8787
NEXT_PUBLIC_SDP_WEB_URL=http://localhost:3000
NEXT_PUBLIC_SDP_DOCS_URL=http://localhost:3001
NEXT_PUBLIC_SOLANA_NETWORK=devnet
ASSET_PROFILES_ENABLED=true
# Private Channels (opt-in). Gates the API routes, the deposit/withdrawal
# reconcilers, and the dashboard workspace. Requires
# SPC_CREDENTIAL_ENCRYPTION_KEY below when enabled.
PRIVATE_CHANNELS_ENABLED=false
# Helius Rings (opt-in, devnet-only). Gates the shielded-wallet API routes
# and the dashboard workspace.
HELIUS_RINGS_ENABLED=false
# All three upstreams below are required once Rings is enabled. Left unset the
# gateway still answers, reporting every component red and naming what is
# missing. Shielded identities come from a test seed hardcoded in the source,
# so this is devnet-only and the keys are not private.
# HELIUS_RINGS_RPC_URL=
# HELIUS_RINGS_INDEXER_URL=
# HELIUS_RINGS_PROVER_URL=
# The public devnet indexer and prover are plain http on a real host. Over
# plaintext an indexer response reveals which notes an identity owns, so
# reaching them is an explicit per-environment choice, never inferred.
HELIUS_RINGS_ALLOW_INSECURE_HTTP=false
SDP_FLAG_ASSET_PROFILES=true
PRIVY_BYOK_ENABLED=false
SELF_HOSTED_STORED_CONNECTION_SETUP_ENABLED=false

# ─── Authentication (Clerk) — REQUIRED ───────────────────────────────────────
# Get these from https://dashboard.clerk.com → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_secret_key

# Clerk issuer — shown in Clerk Dashboard under API Keys.
# Looks like https://<slug>.clerk.accounts.dev for dev instances.
CLERK_ISSUER=https://replace-with-your-instance.clerk.accounts.dev

# Clerk webhook signing secret — required for auto-provisioning organizations.
# Get from Clerk Dashboard → Webhooks → your endpoint → Signing Secret.
# Without this, organizations must be inserted into the DB manually.
# CLERK_WEBHOOK_SECRET=whsec_...

# ─── App secrets ─────────────────────────────────────────────────────────────
# Generate each with: openssl rand -hex 32
# API_KEY_PEPPER hashes API keys before storage; without it keys use no pepper.
# CREDENTIAL_FINGERPRINT_PEPPER signs stored/runtime Credential submission fingerprints;
# it is required when PRIVY_BYOK_ENABLED=true and must stay stable.
# CUSTODY_ENCRYPTION_KEY encrypts org private keys in DB; without it keys are
# stored in plaintext.
# CUSTODY_KMS_KEY_NAME switches custody encryption to Cloud KMS envelope
# encryption when set (keep CUSTODY_ENCRYPTION_KEY to read pre-existing rows).
# Auth uses the runtime service account via the GCP metadata server.
# SPC_CREDENTIAL_ENCRYPTION_KEY encrypts the SPC passwords SDP issues for
# invited Private Channels members; required when PRIVATE_CHANNELS_ENABLED=true.
# Kept separate from CUSTODY_ENCRYPTION_KEY so compromising one does not leak
# the other. Generate with: openssl rand -base64 32
# SPC_CREDENTIAL_KMS_KEY_NAME does the same for SPC credentials as
# CUSTODY_KMS_KEY_NAME does for custody (keep the key above to read older rows).
# API_KEY_PEPPER=
# CREDENTIAL_FINGERPRINT_PEPPER=
# CUSTODY_ENCRYPTION_KEY=
# CUSTODY_KMS_KEY_NAME=projects/<project>/locations/<location>/keyRings/<ring>/cryptoKeys/<key>
# SPC_CREDENTIAL_ENCRYPTION_KEY=
# SPC_CREDENTIAL_KMS_KEY_NAME=projects/<project>/locations/<location>/keyRings/<ring>/cryptoKeys/<key>

# ─── Solana RPC ──────────────────────────────────────────────────────────────
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# For mainnet, use a private RPC (Helius, Nodit, Triton, Alchemy, QuickNode, Validation Cloud, etc.):
# SOLANA_RPC_HELIUS_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# SOLANA_RPC_HELIUS_API_KEY=YOUR_KEY
# SOLANA_RPC_NODIT_URL=https://solana-mainnet.nodit.io/{API_KEY}
# SOLANA_RPC_NODIT_API_KEY=YOUR_NODIT_KEY
# SOLANA_RPC_VALIDATIONCLOUD_URL=https://mainnet.solana.validationcloud.io/v1/{API_KEY}
# SOLANA_RPC_VALIDATIONCLOUD_API_KEY=YOUR_KEY

# ─── Signing provider ───────────────────────────────────────────────────────
# "local" keeps keys in this deployment; other options: fireblocks, privy,
# coinbase_cdp, para, turnkey, dfns, anchorage.
SIGNING_PROVIDER=local
# Privy deployment credentials — required only for legacy or runtime-env setup.
# Omit them when using dashboard-stored Privy Connections only.
# PRIVY_APP_ID=
# PRIVY_APP_SECRET=
# Base58 private key for the fee-payer wallet (required when SIGNING_PROVIDER=local).
# FEE_PAYER_PRIVATE_KEY=

# ─── Fee payment ─────────────────────────────────────────────────────────────
# "native" pays from FEE_PAYER_PRIVATE_KEY; "kora" delegates to a Kora node.
FEE_PAYMENT_PROVIDER=native

# ─── Observability (optional) ────────────────────────────────────────────────
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# ─── MagicBlock private payments (optional) ──────────────────────────────────
# MAGICBLOCK_PRIVATE_PAYMENTS_API_BASE_URL=https://payments.magicblock.app
# MAGICBLOCK_PRIVATE_PAYMENTS_AUTH_TOKEN=
