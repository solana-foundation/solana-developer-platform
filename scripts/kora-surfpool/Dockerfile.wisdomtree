# syntax=docker/dockerfile:1.7

# Surfpool 1.5.0 publishes a Linux x64 native binding but no Linux arm64
# binding. The wrapper builds and runs this image as linux/amd64 on every host.
FROM node:24-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6

ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    SDP_WISDOMTREE_SURFPOOL_IN_CONTAINER=1

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/* \
 && corepack enable \
 && corepack prepare pnpm@10.16.0 --activate

WORKDIR /repo
COPY . .

# Dependencies live only in the image. The integration package contributes the
# pinned embedded Surfpool runtime; the WisdomTree filter carries the SDK/test.
RUN --mount=type=cache,id=sdp-wisdomtree-surfpool-pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile \
      --filter @sdp/wisdomtree... \
      --filter @sdp/api-integration...

CMD ["bash", "scripts/kora-surfpool/e2e-wisdomtree.sh"]
