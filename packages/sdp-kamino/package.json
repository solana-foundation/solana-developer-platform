{
  "name": "@sdp/kamino",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": {
      "types": "./src/client.ts",
      "import": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./deposit-receipt": {
      "types": "./src/deposit-receipt.ts",
      "import": "./src/deposit-receipt.ts",
      "default": "./src/deposit-receipt.ts"
    },
    "./errors": {
      "types": "./src/errors.ts",
      "import": "./src/errors.ts",
      "default": "./src/errors.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check src/"
  },
  "dependencies": {
    "@kamino-finance/klend-sdk": "10.0.0",
    "@sdp/earn": "workspace:*",
    "@sdp/rpc": "workspace:*",
    "@sdp/solana": "workspace:*",
    "@sdp/types": "workspace:*",
    "@solana-program/token": "catalog:",
    "@solana/kit": "catalog:",
    "decimal.js": "10.6.0"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
