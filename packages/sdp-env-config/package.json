{
  "name": "@sdp/env-config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./fields": {
      "types": "./src/fields.ts",
      "import": "./src/fields.ts",
      "default": "./src/fields.ts"
    },
    "./generate": {
      "types": "./src/generate.ts",
      "import": "./src/generate.ts",
      "default": "./src/generate.ts"
    },
    "./local-keypair": {
      "types": "./src/local-keypair.ts",
      "import": "./src/local-keypair.ts",
      "default": "./src/local-keypair.ts"
    },
    "./secrets": {
      "types": "./src/secrets.ts",
      "import": "./src/secrets.ts",
      "default": "./src/secrets.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "import": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./validate": {
      "types": "./src/validate.ts",
      "import": "./src/validate.ts",
      "default": "./src/validate.ts"
    },
    "./tls-trust": {
      "types": "./src/tls-trust.d.cts",
      "default": "./src/tls-trust.cjs"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "lint": "biome check src/"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
