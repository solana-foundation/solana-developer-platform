{
  "name": "@sdp/hastra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "import": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./errors": {
      "types": "./src/errors.ts",
      "import": "./src/errors.ts",
      "default": "./src/errors.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check src/"
  },
  "dependencies": {
    "@sdp/earn": "workspace:*",
    "@sdp/solana": "workspace:*",
    "@sdp/types": "workspace:*",
    "@solana/web3.js": "1.98.4"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
