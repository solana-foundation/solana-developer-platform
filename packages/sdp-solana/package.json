{
  "name": "@sdp/solana",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./address": {
      "types": "./src/address.ts",
      "import": "./src/address.ts",
      "default": "./src/address.ts"
    },
    "./amount": {
      "types": "./src/amount.ts",
      "import": "./src/amount.ts",
      "default": "./src/amount.ts"
    },
    "./asset-ref": {
      "types": "./src/asset-ref.ts",
      "import": "./src/asset-ref.ts",
      "default": "./src/asset-ref.ts"
    },
    "./movement-quote": {
      "types": "./src/movement-quote.ts",
      "import": "./src/movement-quote.ts",
      "default": "./src/movement-quote.ts"
    },
    "./token-2022": {
      "types": "./src/token-2022.ts",
      "import": "./src/token-2022.ts",
      "default": "./src/token-2022.ts"
    },
    "./token-2022.utils": {
      "types": "./src/token-2022.utils.ts",
      "import": "./src/token-2022.utils.ts",
      "default": "./src/token-2022.utils.ts"
    },
    "./token-movement": {
      "types": "./src/token-movement.ts",
      "import": "./src/token-movement.ts",
      "default": "./src/token-movement.ts"
    },
    "./token-amount": {
      "types": "./src/token-amount.ts",
      "import": "./src/token-amount.ts",
      "default": "./src/token-amount.ts"
    },
    "./token-terms": {
      "types": "./src/token-terms.ts",
      "import": "./src/token-terms.ts",
      "default": "./src/token-terms.ts"
    }
  },
  "imports": {
    "#/*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "lint": "biome check src/ scripts/",
    "check:well-known-mints": "tsx scripts/check-well-known-mints.ts"
  },
  "dependencies": {
    "@sdp/rpc": "workspace:*",
    "@sdp/types": "workspace:*",
    "@solana-program/system": "catalog:",
    "@solana-program/token-2022": "catalog:",
    "@solana/addresses": "catalog:",
    "@solana/fixed-points": "7.1.1",
    "@solana/kit": "catalog:",
    "@solana/mosaic-sdk": "catalog:",
    "@solana/signers": "catalog:",
    "@solana/sysvars": "catalog:"
  },
  "devDependencies": {
    "@solana/surfpool": "1.5.0",
    "tsx": "4.23.15"
  }
}
