{
  "name": "@sdp/api-integration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#env-impl": "./src/helpers/env.node.ts",
    "#/*": "./src/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vitest run --typecheck.enabled --typecheck.only --typecheck.include='src/**/*.test.ts' --passWithNoTests"
  },
  "dependencies": {
    "@sdp/private-channels": "workspace:*",
    "@sdp/rpc": "workspace:*",
    "@sdp/spc-escrow": "workspace:*",
    "@sdp/types": "workspace:*",
    "@solana-program/system": "catalog:",
    "@solana/codecs": "catalog:",
    "@solana/kit": "catalog:"
  },
  "devDependencies": {
    "@sdp/api": "workspace:*",
    "@solana/surfpool": "1.5.0",
    "@types/node": "26.6.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "zod": "4.6.5"
  }
}
