# Self-hosted Solana Developer Platform. Copy to .env and fill in.
# Used for compose interpolation (image tag, ports) and loaded into sdp-api as its
# runtime env; web/docs receive only the NEXT_PUBLIC_* values set in compose.yml.

# Image source — pin SDP_VERSION to a release tag for reproducible deploys.
SDP_IMAGE_REGISTRY=ghcr.io/solana-foundation/sdp
SDP_VERSION=latest

# Host ports
SDP_API_PORT=8787
SDP_WEB_PORT=3000
SDP_DOCS_PORT=3001

# Core runtime
ENVIRONMENT=production
SDP_DEPLOYMENT_MODE=self_hosted

# Transactional Email (optional; required before enabling email-sending flows)
EMAIL_FROM=noreply@example.com
# RESEND_API_KEY=re_...

# Database & cache. DATABASE_URL is derived from POSTGRES_* for the bundled
# Postgres; set DATABASE_URL explicitly to point at an external database.
# Generate with `openssl rand -hex 32` (hex is URL-safe, no encoding needed).
POSTGRES_DB=sdp
POSTGRES_USER=sdp
POSTGRES_PASSWORD=
# DATABASE_URL=postgresql://user:password@host:5432/dbname
REDIS_URL=redis://redis:6379

# App secrets.
# API_KEY_PEPPER — generate with `openssl rand -hex 32`.
API_KEY_PEPPER=
# CREDENTIAL_FINGERPRINT_PEPPER — required when Privy BYOK provisioning is enabled.
# Generate with `openssl rand -hex 32` and keep it stable for idempotent replay.
CREDENTIAL_FINGERPRINT_PEPPER=
# CUSTODY_ENCRYPTION_KEY — generate with `openssl rand -base64 32`.
CUSTODY_ENCRYPTION_KEY=
# CUSTODY_KMS_KEY_NAME — optional; routes custody encryption through Cloud KMS
# envelope encryption (keep CUSTODY_ENCRYPTION_KEY to read existing rows).
# CUSTODY_KMS_KEY_NAME=projects/<project>/locations/<location>/keyRings/<ring>/cryptoKeys/<key>
# SPC_CREDENTIAL_ENCRYPTION_KEY — required only when PRIVATE_CHANNELS_ENABLED=true.
# Encrypts the SPC passwords SDP issues for invited members. Kept separate from
# CUSTODY_ENCRYPTION_KEY so compromising one does not leak the other.
# Generate with `openssl rand -base64 32`.
# SPC_CREDENTIAL_ENCRYPTION_KEY=
# SPC_CREDENTIAL_KMS_KEY_NAME — optional; routes SPC credential encryption through
# Cloud KMS envelope encryption (keep the key above to read existing rows).
# SPC_CREDENTIAL_KMS_KEY_NAME=projects/<project>/locations/<location>/keyRings/<ring>/cryptoKeys/<key>

# Public URLs (browser-facing), applied to the web/docs bundles at container start.
# Use base origins (scheme + host[:port]), no trailing path.
NEXT_PUBLIC_SDP_API_BASE_URL=http://localhost:8787
NEXT_PUBLIC_SDP_API_URL=http://localhost:8787
NEXT_PUBLIC_SDP_WEB_URL=http://localhost:3000
NEXT_PUBLIC_SDP_DOCS_URL=http://localhost:3001
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Asset Profiles API routes — keep aligned with the web UI default (apps/sdp-web/src/flags.ts)
SDP_FLAG_ASSET_PROFILES=true
PRIVY_BYOK_ENABLED=false
SELF_HOSTED_STORED_CONNECTION_SETUP_ENABLED=false

# Private Channels is opt-in in every environment — it needs a reachable SPC
# instance. Gates the API routes, the deposit/withdrawal reconcilers, and the
# dashboard workspace. Set SPC_CREDENTIAL_ENCRYPTION_KEY above when enabling.
PRIVATE_CHANNELS_ENABLED=false

# Helius Rings is opt-in and devnet-only. Gates the shielded-wallet API
# routes and the dashboard workspace. Off by default: it reaches external
# infrastructure and, once enabled, can move tokens from the backing custody
# wallet into the shielded pool, so nothing turns it on for you.
HELIUS_RINGS_ENABLED=false

# Authentication (Clerk) — required.
# See apps/sdp-api/docs/self-hosting/clerk-setup.md for full walkthrough.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk issuer — shown in Clerk Dashboard under API Keys.
# Looks like https://<slug>.clerk.accounts.dev for dev instances.
CLERK_ISSUER=

# Clerk webhook signing secret — required for auto-provisioning organizations.
# Get from Clerk Dashboard → Webhooks → your endpoint → Signing Secret.
# Without this, organizations must be inserted into the DB manually.
# CLERK_WEBHOOK_SECRET=whsec_...

# Solana RPC
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Signing provider — local keeps keys in this deployment; managed backends need their own env.
SIGNING_PROVIDER=local
# Base58 keypair the local signer uses to sign transactions. Generate one and fund it.
CUSTODY_PRIVATE_KEY=

# Fee payment — native pays from FEE_PAYER_PRIVATE_KEY (falls back to CUSTODY_PRIVATE_KEY);
# kora delegates to a Kora node.
FEE_PAYMENT_PROVIDER=native
# Optional dedicated fee payer; defaults to CUSTODY_PRIVATE_KEY when blank.
# FEE_PAYER_PRIVATE_KEY=

# Recurring payment collection tuning (collection itself is always on)
PAYMENTS_RECURRING_COLLECTION_BATCH_SIZE=25
PAYMENTS_RECURRING_COLLECTION_RETRY_AFTER_MINUTES=30

# Observability (optional)
# SENTRY_DSN=

# Provider co-signers and automation should be hosted outside the default compose
# stack; see /docs/self-hosting/external-co-signers and infra/utila/cloud-run.
# Other optional integrations (compliance, fiat ramps, more signing backends) use
# the same mechanism; see the self-hosting docs.
