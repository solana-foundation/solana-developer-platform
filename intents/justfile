default:
    @just --list

fmt:
    cargo fmt --all

check:
    cargo fmt --all -- --check
    cargo clippy --workspace --all-targets -- -D warnings
    cargo build -q -p sdp-intents-engine --target thumbv7em-none-eabi
    RUSTDOCFLAGS="-D warnings" cargo doc -q --no-deps --workspace
    cargo run -q -p sdp-intents-cli -- lint

lint-definitions *paths:
    cargo run -q -p sdp-intents-cli -- lint {{paths}}

build:
    cargo build --workspace

test:
    cargo test --workspace

unit-test:
    cargo test --workspace --lib

# The onchain programs are a separate workspace, with its own Cargo.lock.
build-programs:
    cd programs && for manifest in */Cargo.toml; do if grep -q cdylib "$manifest"; then cargo build-sbf --manifest-path "$manifest"; fi; done

# The mainnet programs that the tests run, checked against their pinned hashes.
fetch-programs:
    cd programs && node fetch-programs.mjs

test-programs: build-programs fetch-programs
    cd programs && cargo test --workspace
