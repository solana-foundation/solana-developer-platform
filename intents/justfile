default:
    @just --list

fmt:
    cargo fmt --all

check:
    cargo fmt --all -- --check
    cargo clippy --workspace --all-targets -- -D warnings
    cargo build -q -p sdp-intents-engine --target thumbv7em-none-eabi
    cargo build -q -p sdp-intents-verifier-wasm --target wasm32-unknown-unknown
    RUSTDOCFLAGS="-D warnings" cargo doc -q --no-deps --workspace
    cargo run -q -p sdp-intents-cli -- lint

lint-definitions *paths:
    cargo run -q -p sdp-intents-cli -- lint {{paths}}

build:
    cargo build --workspace

test:
    cargo test --workspace

unit-test:
    cargo test --workspace --lib

# The onchain programs are a separate workspace, with its own Cargo.lock.
build-programs:
    cd programs && for manifest in */Cargo.toml; do if grep -q cdylib "$manifest"; then cargo build-sbf --manifest-path "$manifest"; fi; done

# The IDL of each Anchor program, in `programs/target/idl`. `deploy-surfnet.mjs` places each one
# beside its program, so that Solana Explorer decodes the instructions.
idl:
    cd programs && cargo run -q -p sdp-intents-idl

# The verifier as WebAssembly, in `packages/sdp-intents-verifier/wasm`. The playground and the e2e
# verify with it.
build-verifier:
    node ../packages/sdp-intents-verifier/build-wasm.mjs

# The mainnet programs that the tests run, checked against their pinned hashes.
fetch-programs:
    node programs/tools/fetch-programs.mjs

# Helius privacy rings: Zolana's programs, localnet accounts, Photon, and prover, checked against
# their pinned hashes. `deploy-surfnet.mjs` places them when they are here.
fetch-zolana:
    node programs/tools/fetch-zolana.mjs

# Zolana's Photon indexer and prover against a running surfnet. It runs in the foreground.
zolana rpc="http://127.0.0.1:8899":
    node programs/tools/zolana-services.mjs {{rpc}}

test-programs: build-programs fetch-programs idl
    cd programs && cargo test --workspace

# A local surfnet that forks mainnet, for `e2e`. It runs in the foreground.
surfnet:
    surfpool start --network mainnet --no-tui --no-studio --no-deploy --airdrop-amount 0

# The whole flow against a running surfnet: place the programs, publish the definitions, then plan,
# verify, and send intents with every onchain check on, then send one privately through the ring.
e2e rpc="http://127.0.0.1:8899": build-programs build-verifier fetch-zolana
    cargo build -q -p sdp-intents-cli -p sdp-intents-service -p sdp-intents-test-provider
    node programs/tools/deploy-surfnet.mjs {{rpc}}
    node e2e/run.mjs {{rpc}}

# A surfnet for `apps/intents-playground`: place the programs, fund the playground wallets, publish
# the definitions, then serve the API with those wallets. It runs in the foreground.
playground rpc="http://127.0.0.1:8899": build-programs idl build-verifier fetch-zolana
    cargo build -q -p sdp-intents-cli -p sdp-intents-service -p sdp-intents-test-provider
    node programs/tools/deploy-surfnet.mjs {{rpc}}
    node e2e/playground.mjs {{rpc}}
    bash -c 'trap "kill 0" EXIT; node programs/tools/zolana-services.mjs {{rpc}} & node adapters/jupiter.mjs & ./target/debug/sdp-intents-test-provider {{rpc}} & ./target/debug/sdp-intents-service --rpc {{rpc}} --wallets target/playground/wallets --ring-indexer http://127.0.0.1:8784'
