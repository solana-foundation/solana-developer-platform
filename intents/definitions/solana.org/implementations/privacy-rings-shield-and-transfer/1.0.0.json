{
  "spec": "sdp-intents@1.1",
  "kind": "implementation",
  "id": "solana.org/privacy-rings-shield-and-transfer",
  "version": "1.0.0",
  "cluster": "5eykt4UsFv8P8NJdTREpY1vzqKqZKvdpKuc147dw2N9d",
  "implements": "solana.org/private.transfer@^1",
  "applies": [
    {
      "value": "{inputs.mint}",
      "equals": "11111111111111111111111111111111"
    }
  ],
  "message": "privately send {inputs.amount} of {inputs.mint} from {inputs.from} to {inputs.to}, after shielding that amount of public funds",
  "recipe": {
    "kind": "flow",
    "steps": [
      {
        "name": "shield",
        "intent": {
          "interface": "solana.org/private.shield@^1",
          "implementation": "solana.org/privacy-rings-shield@^1",
          "inputs": {
            "owner": "{inputs.from}",
            "mint": "{inputs.mint}",
            "amount": "{inputs.amount}"
          }
        }
      },
      {
        "name": "transfer",
        "intent": {
          "interface": "solana.org/private.transfer@^1",
          "implementation": "solana.org/privacy-rings-transfer@^1",
          "inputs": {
            "from": "{inputs.from}",
            "to": "{inputs.to}",
            "mint": "{inputs.mint}",
            "amount": "{inputs.amount}"
          }
        },
        "done": {
          "spent": "{steps.transfer.plan.nullifiers}",
          "message": "the notes that the transfer consumes are spent"
        }
      }
    ]
  }
}
