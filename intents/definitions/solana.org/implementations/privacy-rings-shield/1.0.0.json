{
  "spec": "sdp-intents@1.1",
  "kind": "implementation",
  "id": "solana.org/privacy-rings-shield",
  "version": "1.0.0",
  "cluster": "5eykt4UsFv8P8NJdTREpY1vzqKqZKvdpKuc147dw2N9d",
  "implements": "solana.org/private.shield@^1",
  "applies": [
    {
      "value": "{inputs.mint}",
      "equals": "11111111111111111111111111111111"
    }
  ],
  "message": "shield {inputs.amount} of {inputs.mint} from {inputs.owner} into Solana Privacy Rings' default ring",
  "recipe": {
    "kind": "shielded",
    "protocol": "privacy-rings",
    "pool": "ring1GaLCuJnkUMVkX2JeZLTTX17wKsV4fZmPVzXANW",
    "accounts": [
      {
        "name": "spender",
        "address": "{inputs.owner}",
        "writable": true
      }
    ],
    "notes": [
      {
        "owner": "spender",
        "asset": {
          "value": "{inputs.mint}",
          "encoding": "address"
        },
        "amount": {
          "value": "{inputs.amount}",
          "encoding": "u64le"
        }
      }
    ]
  },
  "postConditions": [
    {
      "invokesOnly": [
        "ring1GaLCuJnkUMVkX2JeZLTTX17wKsV4fZmPVzXANW"
      ],
      "message": "only the privacy ring's pool runs"
    }
  ]
}
