{
  "spec": "sdp-intents@1.1",
  "kind": "implementation",
  "id": "solana.org/privacy-rings-transfer",
  "version": "1.0.0",
  "cluster": "5eykt4UsFv8P8NJdTREpY1vzqKqZKvdpKuc147dw2N9d",
  "implements": "solana.org/token.transfer@^1",
  "applies": [{ "value": "{inputs.memo}", "present": false }],
  "message": "privately send {inputs.amount} of {inputs.mint} from the private balance of {inputs.from} to {inputs.to}, in Solana Privacy Rings' default ring",
  "recipe": {
    "kind": "shielded",
    "protocol": "privacy-rings",
    "pool": "ring1GaLCuJnkUMVkX2JeZLTTX17wKsV4fZmPVzXANW",
    "circuit": "solana.org/privacy-rings-confidential@1.0.0",
    "accounts": [
      {
        "name": "spender",
        "address": "{inputs.from}"
      },
      {
        "name": "recipient",
        "address": "{inputs.to}"
      }
    ],
    "notes": [
      {
        "owner": "recipient",
        "asset": {
          "value": "{inputs.mint}",
          "encoding": "address"
        },
        "amount": {
          "value": "{inputs.amount}",
          "encoding": "u64le"
        }
      }
    ]
  },
  "postConditions": [
    {
      "noOutflow": { "from": "{inputs.from}", "mint": "{inputs.mint}" },
      "message": "{inputs.from} sends none of {inputs.mint} from its public balance"
    },
    {
      "invokesOnly": [
        "ring1GaLCuJnkUMVkX2JeZLTTX17wKsV4fZmPVzXANW"
      ],
      "message": "only the privacy ring's pool runs"
    }
  ]
}
