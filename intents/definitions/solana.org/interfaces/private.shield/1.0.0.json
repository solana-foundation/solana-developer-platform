{
  "spec": "sdp-intents@1.0",
  "kind": "interface",
  "id": "solana.org/private.shield",
  "version": "1.0.0",
  "inputs": [
    { "name": "owner", "type": "address", "signer": true },
    { "name": "mint", "type": "mint" },
    { "name": "amount", "type": "u64", "display": { "amount": { "mint": "{inputs.mint}" } } }
  ],
  "outputs": [],
  "display": "Shield {inputs.amount} {inputs.mint} into a privacy ring",
  "postConditions": [
    { "outflow": { "from": "{inputs.owner}", "mint": "{inputs.mint}", "max": "{inputs.amount}" },
      "message": "{inputs.owner} sends at most {inputs.amount} of {inputs.mint} from its public balance" },
    { "noOtherOutflows": { "from": "{inputs.owner}" },
      "message": "nothing else leaves the public accounts of {inputs.owner}" }
  ]
}
