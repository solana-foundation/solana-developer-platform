+/**
+ * A Kit RPC transport that dials `rpcUrl` through `fetchImpl` instead of the
+ * global fetch. Same wire shape as the default HTTP transport — JSON-RPC POST,
+ * `accept`/`content-type` headers, abort signal passed through, `SolanaError`
+ * on a non-2xx — minus request coalescing, which is an optimization. Callers
+ * that supply a fetch do so to route the leg through their own egress guard.
+ */
+function fetchBackedRpcTransport(fetchImpl, rpcUrl) {
+    return async ({ payload, signal }) => {
+        const response = await fetchImpl(rpcUrl, {
+            body: JSON.stringify(payload),
+            headers: {
+                accept: "application/json",
+                "content-type": "application/json; charset=utf-8",
+            },
+            method: "POST",
+            ...(signal === undefined ? {} : { signal }),
+        });
+        if (!response.ok) {
+            throw new SolanaError(SOLANA_ERROR__RPC__TRANSPORT_HTTP_ERROR, {
+                headers: response.headers,
+                message: response.statusText,
+                statusCode: response.status,
+            });
+        }
+        return await response.json();
+    };
