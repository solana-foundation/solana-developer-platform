# AWS region of the bucket below.
AWS_REGION=us-east-1

# Local-only. Leave unset to use the default AWS credential chain
# (aws configure / instance role). Never set these in ECS — the task role
# is used there instead.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ─── GET /rpc ────────────────────────────────────────────────────────────────
# Delta table the /rpc cache reads and writes.
RPC_TABLE_NAME=dev.mlh.rpc_counts
# Bucket the dotted table name above is resolved against.
S3_INSERT_BUCKET=your-bucket
# How long a cached count stays fresh, in seconds.
RPC_CACHE_TTL_SECONDS=3600
# RPC for devnet, the cluster used when no ?cluster= is given.
SOLANA_RPC_URL=https://api.devnet.solana.com

# ─── GET /rpc/transfers ──────────────────────────────────────────────────────
# Delta table caching one row per transaction.
TRANSFERS_TABLE_NAME=dev.mlh.rpc
# How long after checking the chain a partial page still counts as complete.
TRANSFER_CACHE_TTL_SECONDS=300
# Signatures one request may resolve to amounts. Raise it for a paid RPC provider.
ENRICH_BUDGET=25

# ─── Security ────────────────────────────────────────────────────────────────
# Required for POST /insert, sent as X-API-Token. Unset means /insert answers 503.
# API_WRITE_TOKEN=
# Every /insert table_name must start with this.
INSERT_TABLE_PREFIX=dev.mlh.
# Allows ?rpc= on /rpc. Leave off anywhere the service is reachable by others.
# ALLOW_RPC_URL_OVERRIDE=false

PORT=8080
