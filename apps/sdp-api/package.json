{
  "name": "@sdp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "dev:local": "node scripts/dev-local.mjs",
    "dev:db": "pnpm -w db:postgres:up && pnpm -w db:postgres:logs",
    "dev:webhook": "bash scripts/dev-webhook.sh",
    "build": "node scripts/build-node.mjs",
    "db:migrate:local": "DATABASE_URL=${DATABASE_URL:-postgresql://sdp:sdp@127.0.0.1:5432/sdp} node scripts/migrate-postgres.mjs",
    "db:migrate:test": "node scripts/migrate-postgres-test.mjs",
    "db:migrate:dev": "node scripts/migrate-postgres.mjs",
    "db:migrate:production": "node scripts/migrate-postgres.mjs",
    "db:verify": "node scripts/verify-postgres.mjs",
    "audit:ledger": "node scripts/audit-ledger.mjs",
    "db:seed:local": "psql \"${DATABASE_URL:-postgresql://sdp:sdp@127.0.0.1:5432/sdp}\" -f src/db/seeds/local.sql",
    "db:spc:reset:local": "DATABASE_URL=${DATABASE_URL:-postgresql://sdp:sdp@127.0.0.1:5432/sdp} node scripts/spc-reset-postgres.mjs",
    "db:seed:issuance": "tsx scripts/seed-issuance-demo.ts",
    "db:seed:earn": "tsx scripts/seed-earn-demo.ts",
    "db:postgres:bootstrap": "DATABASE_URL=${DATABASE_URL:-postgresql://sdp:sdp@127.0.0.1:5432/sdp} node scripts/migrate-postgres.mjs",
    "org:tier:local": "tsx scripts/set-organization-tier-local.ts",
    "keygen:local": "tsx scripts/generate-local-keypair.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "playground:generate": "tsx scripts/generate-playground-catalog.ts",
    "playground:check": "tsx scripts/generate-playground-catalog.ts --check",
    "earn:inventory": "doppler run --config ${DOPPLER_CONFIG:-dev} -- tsx scripts/inventory-ground-catalogue.ts fetch",
    "earn:inventory:render": "tsx scripts/inventory-ground-catalogue.ts render",
    "rails:discover": "doppler run --config ${DOPPLER_CONFIG:-dev} -- tsx scripts/discover-ramp-rails.ts discover",
    "rails:generate": "tsx scripts/discover-ramp-rails.ts generate",
    "rails:drift": "tsx scripts/discover-ramp-rails.ts drift",
    "test": "vitest run",
    "test:serial": "vitest run --no-file-parallelism --maxWorkers=1",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@clerk/backend": "3.15.0",
    "@hono/node-server": "^2.0.12",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "@sdp/custody": "workspace:*",
    "@sdp/earn": "workspace:*",
    "@sdp/env-config": "workspace:*",
    "@sdp/issuance": "workspace:*",
    "@sdp/payments": "workspace:*",
    "@sdp/policy": "workspace:*",
    "@sdp/private-channels": "workspace:*",
    "@sdp/rpc": "workspace:*",
    "@sdp/spc-escrow": "workspace:*",
    "@sdp/spc-withdraw": "workspace:*",
    "@sdp/solana": "workspace:*",
    "@sdp/types": "workspace:*",
    "@sentry/node": "^10.69.0",
    "@solana-program/system": "catalog:",
    "@solana-program/token": "catalog:",
    "@solana-program/token-2022": "catalog:",
    "@solana/addresses": "catalog:",
    "@solana/codecs": "catalog:",
    "@solana/keychain-cdp": "1.4.0",
    "@solana/keychain-core": "1.4.0",
    "@solana/keychain-fireblocks": "1.4.0",
    "@solana/keychain-para": "1.4.0",
    "@solana/keychain-privy": "1.4.0",
    "@solana/keychain-turnkey": "1.4.0",
    "@solana/keychain-utila": "1.4.0",
    "@solana/kit": "catalog:",
    "@solana/kora": "0.3.0-beta.2",
    "@solana/mosaic-sdk": "catalog:",
    "@solana/pay": "1.0.26",
    "@solana/signers": "catalog:",
    "@solana/subscriptions": "0.4.0",
    "@solana/token-acl-gate-sdk": "0.3.0",
    "@solana/transactions": "catalog:",
    "hono": "^4.12.34",
    "ioredis": "^6.0.0",
    "jose": "^6.2.7",
    "nanoid": "^5.1.16",
    "node-cron": "^4.6.0",
    "pg": "^8.22.0",
    "pino": "^9.5.0",
    "react": "19.2.8",
    "resend": "6.18.1",
    "zod": "4.4.3",
    "@coinbase/cdp-sdk": "1.54.0"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@testcontainers/postgresql": "12.0.4",
    "@testcontainers/redis": "12.0.4",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "@types/react": "^19.2.18",
    "@vitest/coverage-istanbul": "4.1.10",
    "esbuild": "0.28.1",
    "openapi3-ts": "4.6.1",
    "pino-pretty": "^13.0.0",
    "testcontainers": "12.0.4",
    "tsx": "4.23.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
