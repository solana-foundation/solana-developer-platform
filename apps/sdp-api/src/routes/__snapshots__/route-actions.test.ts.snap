exports[`route actions > pins every route without an action, with its reason 1`] = `
[
  "DELETE /admin/allowlist/:id: operator: ALLOWLIST_ADMIN_KEY or a platform administrator, not a tenant grant",
  "GET /: root: redirects to the health check",
  "GET /admin/allowlist: operator: ALLOWLIST_ADMIN_KEY or a platform administrator, not a tenant grant",
  "GET /docs: API reference page",
  "GET /health/ready: readiness check",
  "GET /health: health check",
  "GET /internal/dashboard/network: a dashboard session reads chain-wide figures; no tenant data",
  "GET /llms.txt: AI discovery resource",
  "GET /openapi.json: public OpenAPI document",
  "GET /pay/:token/tx: payment link: the link's public token is the credential",
  "GET /pay/:token: payment link: the link's public token is the credential",
  "GET /v1/issuance/tokens/:tokenId/metadata.json: token metadata: public on-chain metadata a wallet or explorer fetches",
  "GET /v1/onboarding/status: onboarding: a Clerk session before its organization is provisioned",
  "POST /admin/allowlist: operator: ALLOWLIST_ADMIN_KEY or a platform administrator, not a tenant grant",
  "POST /pay/:token/tx: payment link: the link's public token is the credential",
  "POST /v1/members/accept: invitation accept: the invitation token authorizes a signed-in invitee who is not a member yet",
  "POST /v1/onboarding/complete: onboarding: a Clerk session before its organization is provisioned",
  "POST /webhooks/clerk/link-orgs: signed webhook: Clerk's signature authenticates it",
  "POST /webhooks/payments/ramps/production/:provider: signed webhook: the ramp provider's signature authenticates it",
  "POST /webhooks/payments/ramps/sandbox/:provider: signed webhook: the ramp provider's signature authenticates it",
]
`;
