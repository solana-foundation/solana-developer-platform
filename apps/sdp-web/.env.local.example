# SDP Web local environment (copy to .env.local)

# Clerk authentication (required) — get from https://dashboard.clerk.com
# Self-hosted setup walkthrough: apps/sdp-api/docs/self-hosting/clerk-setup.md
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# SDP API endpoint (required)
NEXT_PUBLIC_SDP_API_BASE_URL=http://127.0.0.1:8787
# Optional server-side override for BFF routes (defaults to the public URL above)
# SDP_API_BASE_URL=http://127.0.0.1:8787

# Docs site URL for in-dashboard documentation links (optional)
# NEXT_PUBLIC_SDP_DOCS_URL=http://localhost:3001

# Error tracking (optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Feature flag overrides (optional, "true"/"false"; ignored on Vercel deploys — defaults in src/flags.ts)
# SDP_FLAG_HOMEPAGE_OPEN_SIGNUP=true
# Payments' Demo switch (sample data, simulated ramps and KYC). On by default outside
# production.
# SDP_FLAG_PAYMENTS_DEMO_MODE=false
# Dashboard module flags are off by default. They hide dashboard UI only; the
# public API and API key authoring remain available.
# ISSUANCE_ENABLED=true
# Asset Profiles is a sub-module and also requires ISSUANCE_ENABLED.
# SDP_FLAG_ASSET_PROFILES=true

# --- Explorer links ---
# Where the Solana Explorer should read from, when that is not the project's own
# cluster. A project's environment says which network it belongs to; against a
# local validator or a devnet fork the transactions live somewhere else entirely,
# so a link built from the cluster alone opens an explorer page for an account
# that network has never seen — which reads as the transaction having failed.
#
# Set this only when running against a local validator. Never point it at a
# provider endpoint: those carry an API key in the query string, and this value
# goes into a public href on every page that links a signature.
# NEXT_PUBLIC_SOLANA_EXPLORER_RPC_URL=http://127.0.0.1:8899
