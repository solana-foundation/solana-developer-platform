{
  "name": "sdp-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "check:i18n": "node scripts/audit-ui-copy.mjs",
    "check:i18n:baseline": "node scripts/audit-ui-copy.mjs --write",
    "check:i18n:strict": "node scripts/audit-ui-copy.mjs --strict",
    "test:e2e": "playwright test --config=playwright.config.ts --project=public --project=dashboard --project=issuance",
    "test:e2e:dashboard": "playwright test --config=playwright.config.ts --project=public --project=dashboard",
    "test:e2e:dashboard-transactions": "playwright test --config=playwright.config.ts --project=dashboard-transactions",
    "test:e2e:issuance": "playwright test --config=playwright.config.ts --project=issuance",
    "test:e2e:gcp-smoke": "playwright test --config=playwright.config.ts --project=gcp-read-only --workers=1",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@clerk/nextjs": "7.8.0",
    "@flags-sdk/vercel": "1.4.6",
