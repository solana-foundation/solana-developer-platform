    "@sdp/private-channels": "workspace:*",
    "@sdp/solana": "workspace:*",
    "@sdp/types": "workspace:*",
    "@sentry/nextjs": "10.70.0",
    "@solana/design-system": "1.0.1",
    "@solana/fixed-points": "7.1.0",
    "@solana/qr-code-styling": "1.6.0",
    "@vercel/flags-core": "1.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "flags": "4.3.0",
    "lucide-react": "1.33.0",
    "motion": "13.1.1",
    "next": "16.3.2",
    "next-themes": "0.4.6",
    "qrcode": "1.5.4",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.8",
    "shiki": "4.4.3",
    "sonner": "2.0.8",
    "swr": "2.5.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
