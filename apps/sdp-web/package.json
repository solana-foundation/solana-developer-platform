    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-istanbul": "4.1.11",
    "eslint": "10.9.0",
    "eslint-config-next": "16.3.2",
    "jsdom": "30.0.1",
    "pg": "8.23.0",
