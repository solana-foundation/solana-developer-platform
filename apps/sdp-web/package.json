{
  "name": "sdp-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "check:i18n": "node scripts/audit-ui-copy.mjs",
    "check:i18n:baseline": "node scripts/audit-ui-copy.mjs --write",
    "check:i18n:strict": "node scripts/audit-ui-copy.mjs --strict",
    "test:e2e": "playwright test --config=playwright.config.ts --project=public --project=dashboard --project=issuance",
    "test:e2e:dashboard": "playwright test --config=playwright.config.ts --project=public --project=dashboard",
    "test:e2e:dashboard-transactions": "playwright test --config=playwright.config.ts --project=dashboard-transactions",
    "test:e2e:issuance": "playwright test --config=playwright.config.ts --project=issuance",
    "test:e2e:gcp-smoke": "playwright test --config=playwright.config.ts --project=gcp-read-only --workers=1",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@clerk/nextjs": "7.9.19",
    "@flags-sdk/vercel": "1.5.2",
    "@sdp/api-catalog": "workspace:*",
    "@sdp/design-tokens": "workspace:*",
    "@sdp/issuance": "workspace:*",
    "@sdp/private-channels": "workspace:*",
    "@sdp/redaction": "workspace:*",
    "@sdp/solana": "workspace:*",
    "@sdp/types": "workspace:*",
    "@sdp/ui": "workspace:*",
    "@sentry/nextjs": "10.76.0",
    "@solana/design-system": "1.0.1",
    "@solana/fixed-points": "7.1.1",
    "@solana/qr-code-styling": "1.6.0",
    "date-fns": "4.4.0",
    "flags": "4.3.1",
    "lucide-react": "1.61.0",
    "motion": "13.4.4",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "swr": "2.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@clerk/backend": "3.26.1",
    "@clerk/testing": "2.2.49",
    "@playwright/test": "1.64.1",
    "@solana-program/system": "catalog:",
    "@solana/kit": "catalog:",
