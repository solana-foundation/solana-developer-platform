{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "semicolons": "always",
      "quoteStyle": "double",
      "trailingCommas": "es5"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "useExhaustiveDependencies": "warn",
        "noUnusedPrivateClassMembers": "error",
        "noPrivateImports": "error",
        "noUndeclaredDependencies": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noImplicitAnyLet": "error",
        "noDoubleEquals": "error",
        "noConfusingVoidType": "error",
        "noAsyncPromiseExecutor": "error",
        "noUnsafeDeclarationMerging": "error",
        "noVar": "error",
        "noTsIgnore": "error",
        "noImportCycles": "error"
      },
      "style": {
        "noNonNullAssertion": "warn",
        "useConst": "error",
        "noEnum": "error",
        "useImportType": "error",
        "noDefaultExport": "error",
        "noExportedImports": "error",
        "useExportType": "error",
        "useNodejsImportProtocol": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["../**", "!../package.json"],
                "message": "Parent-relative imports are banned (ADR 0010). Use @/ in an app, #/ inside a package, @sdp/<pkg>/<subpath> across workspaces."
              }
            ]
          }
        }
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 30
          }
        },
        "noBannedTypes": "error",
        "noUselessTypeConstraint": "error",
        "noStaticOnlyClass": "error"
      },
      "security": {
        "noDangerouslySetInnerHtml": "error",
        "noSecrets": "error"
      },
      "nursery": {}
    }
  },
  "overrides": [
    {
      "includes": ["**/apps/sdp-api/**/*.ts", "**/apps/sdp-api/**/*.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    },
    {
      "includes": ["**/apps/sdp-api/scripts/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/apps/sdp-web/src/**/*.ts",
        "**/apps/sdp-web/src/**/*.tsx",
        "**/packages/sdp-ui/src/**/*.ts",
        "**/packages/sdp-ui/src/**/*.tsx"
      ],
      "linter": {
        "rules": {
          "security": {
            "noSecrets": {
              "level": "error",
              "options": {
                "entropyThreshold": 100
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/src/openapi/**/*.ts", "**/apps/sdp-api/src/openapi/**/*.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          },
          "nursery": {},
          "security": {
            "noSecrets": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/apps/sdp-docs/scripts/generate-postman-collection.mjs",
        "**/scripts/generate-postman-collection.mjs"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          },
          "nursery": {},
          "security": {
            "noSecrets": "off"
          }
        }
      }
    },
    {
      "includes": ["**/issuance/templates/**/*.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          },
          "nursery": {},
          "security": {
            "noSecrets": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.test.js",
        "**/*.test.jsx",
        "**/test-fixtures.ts",
        "**/test/**/*.ts",
        "**/test/**/*.tsx",
        "**/test/**/*.js",
        "**/test/**/*.jsx",
        "**/__tests__/**/*.ts",
        "**/__tests__/**/*.tsx",
        "**/__tests__/**/*.js",
        "**/__tests__/**/*.jsx"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          },
          "nursery": {},
          "security": {
            "noSecrets": "off"
          }
        }
      }
    },
    {
      "includes": ["**/apps/sdp-web/src/**/*.ts", "**/apps/sdp-web/src/**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@sdp/types/unified-transactions": {
                    "importNames": [
                      "UNIFIED_TRANSACTION_MODULES",
                      "UNIFIED_TRANSACTION_SDP_MODULES"
                    ],
                    "message": "Raw module and provider lists ignore the release channel. Derive the list from the channel-capped flags: enabledTransactionModules(flags), getEnabledRampProviders(), isModuleInDeploymentReleaseChannel(). See docs/decisions/0005-release-channels.md."
                  },
                  "@sdp/types/release-channels": {
                    "importNames": ["SDP_MODULES"],
                    "message": "Raw module and provider lists ignore the release channel. Derive the list from the channel-capped flags: enabledTransactionModules(flags), getEnabledRampProviders(), isModuleInDeploymentReleaseChannel(). See docs/decisions/0005-release-channels.md."
                  },
                  "@sdp/types/provider-access": {
                    "importNames": ["RAMP_PROVIDERS"],
                    "message": "Raw module and provider lists ignore the release channel. Derive the list from the channel-capped flags: enabledTransactionModules(flags), getEnabledRampProviders(), isModuleInDeploymentReleaseChannel(). See docs/decisions/0005-release-channels.md."
                  }
                },
                "patterns": [
                  {
                    "group": ["../**", "!../package.json"],
                    "message": "Parent-relative imports are banned (ADR 0010). Use @/ in an app, #/ inside a package, @sdp/<pkg>/<subpath> across workspaces."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/apps/sdp-web/src/flags/**",
        "**/apps/sdp-web/src/**/*.test.ts",
        "**/apps/sdp-web/src/**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../**", "!../package.json"],
                    "message": "Parent-relative imports are banned (ADR 0010). Use @/ in an app, #/ inside a package, @sdp/<pkg>/<subpath> across workspaces."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/apps/sdp-api/**/*.ts", "**/packages/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@sdp/rpc/scope": {
                    "allowImportNames": ["currentClusterScope", "ClusterScope"],
                    "message": "Only cluster-scope entry points (project middleware, job runner, webhook handlers, anonymous Earn) may open a scope with runInClusterScope. Read the open scope with currentClusterScope() or createClusterRpc(). See docs/decisions/0007-cluster-scope-ambient.md."
                  },
                  "@sdp/rpc/factory": {
                    "importNames": ["createClusterHistoryRpc", "createKoraUpstreamRpc"],
                    "message": "Only observed transfers (observed-transfers.ts and the transfers list in transfers/handlers.ts) may read through createClusterHistoryRpc (the Helius-first pool for wallet signature history). Only @sdp/fee-payment may read through createKoraUpstreamRpc (the Fee Payer's own RPC, kept off the managed pool); call its sponsoredNetworkFee, getSponsoredTransaction or isSponsoredBlockhashValid. Everything else uses createClusterRpc(). See docs/decisions/0007-cluster-scope-ambient.md."
                  },
                  "@sdp/rpc/helius-das": "Only services/helius-das.service.ts may send Helius DAS requests: DAS is Helius-only, so it bypasses the managed pool, and no caller should reach for a provider directly. Use createClusterRpc() for standard RPC. See docs/decisions/0007-cluster-scope-ambient.md."
                },
                "patterns": [
                  {
                    "group": ["../**", "!../package.json"],
                    "message": "Parent-relative imports are banned (ADR 0010). Use @/ in an app, #/ inside a package, @sdp/<pkg>/<subpath> across workspaces."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/apps/sdp-api/**/*.test.ts",
        "**/apps/sdp-api/**/test/**/*.ts",
        "**/packages/**/*.test.ts",
        "**/packages/**/*.spec.ts",
        "**/packages/**/test/**/*.ts",
        "**/apps/sdp-api/src/middleware/project-context.ts",
        "**/apps/sdp-api/src/runtime/cluster-scope-runs.ts",
        "**/apps/sdp-api/src/routes/pay/context.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@sdp/rpc/scope": {
                    "allowImportNames": [
                      "currentClusterScope",
                      "ClusterScope",
                      "runInClusterScope"
                    ],
                    "message": "Only cluster-scope entry points (project middleware, job runner, webhook handlers, anonymous Earn) may open a scope with runInClusterScope. Read the open scope with currentClusterScope() or createClusterRpc(). See docs/decisions/0007-cluster-scope-ambient.md."
                  },
                  "@sdp/rpc/factory": {
                    "importNames": ["createClusterHistoryRpc", "createKoraUpstreamRpc"],
                    "message": "Only observed transfers (observed-transfers.ts and the transfers list in transfers/handlers.ts) may read through createClusterHistoryRpc (the Helius-first pool for wallet signature history). Only @sdp/fee-payment may read through createKoraUpstreamRpc (the Fee Payer's own RPC, kept off the managed pool); call its sponsoredNetworkFee, getSponsoredTransaction or isSponsoredBlockhashValid. Everything else uses createClusterRpc(). See docs/decisions/0007-cluster-scope-ambient.md."
                  },
                  "@sdp/rpc/helius-das": "Only services/helius-das.service.ts may send Helius DAS requests: DAS is Helius-only, so it bypasses the managed pool, and no caller should reach for a provider directly. Use createClusterRpc() for standard RPC. See docs/decisions/0007-cluster-scope-ambient.md."
                },
                "patterns": [
                  {
                    "group": ["../**", "!../package.json"],
                    "message": "Parent-relative imports are banned (ADR 0010). Use @/ in an app, #/ inside a package, @sdp/<pkg>/<subpath> across workspaces."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/app/**/page.ts",
        "**/app/**/page.tsx",
        "**/app/**/layout.ts",
        "**/app/**/layout.tsx",
        "**/app/**/loading.ts",
        "**/app/**/loading.tsx",
        "**/app/**/error.ts",
        "**/app/**/error.tsx",
        "**/app/**/not-found.ts",
        "**/app/**/not-found.tsx",
        "**/app/**/template.ts",
        "**/app/**/template.tsx",
        "**/app/**/default.ts",
        "**/app/**/default.tsx",
        "**/app/**/global-error.ts",
        "**/app/**/global-error.tsx",
        "**/app/**/opengraph-image.ts",
        "**/app/**/opengraph-image.tsx",
        "**/app/**/twitter-image.ts",
        "**/app/**/twitter-image.tsx",
        "**/app/**/sitemap.ts",
        "**/app/**/sitemap.tsx",
        "**/app/**/robots.ts",
        "**/app/**/robots.tsx",
        "**/app/**/manifest.ts",
        "**/app/**/manifest.tsx",
        "**/src/middleware.ts",
        "**/src/proxy.ts",
        "**/src/instrumentation.ts",
        "**/*.config.ts",
        "**/*.config.mts",
        "**/*.config.js",
        "**/*.config.mjs",
        "**/mdx-components.tsx",
        "**/agents/sdp-translation-agent/agent/agent.ts",
        "**/agents/sdp-translation-agent/agent/channels/*.ts",
        "**/agents/sdp-translation-agent/agent/tools/*.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/apps/*/src/**/*.ts",
        "**/apps/*/src/**/*.tsx",
        "**/packages/*/src/**/*.ts",
        "**/packages/*/src/**/*.tsx",
        "!**/packages/sdp-dvp/**",
        "!**/packages/sdp-spc-escrow/**",
        "!**/packages/sdp-spc-withdraw/**",
        "!**/packages/bigint-buffer/**",
        "!**/app/**/page.ts",
        "!**/app/**/page.tsx",
        "!**/app/**/layout.ts",
        "!**/app/**/layout.tsx",
        "!**/app/**/loading.ts",
        "!**/app/**/loading.tsx",
        "!**/app/**/error.ts",
        "!**/app/**/error.tsx",
        "!**/app/**/not-found.ts",
        "!**/app/**/not-found.tsx",
        "!**/app/**/template.ts",
        "!**/app/**/template.tsx",
        "!**/app/**/default.ts",
        "!**/app/**/default.tsx",
        "!**/app/**/global-error.ts",
        "!**/app/**/global-error.tsx",
        "!**/app/**/opengraph-image.ts",
        "!**/app/**/opengraph-image.tsx",
        "!**/app/**/twitter-image.ts",
        "!**/app/**/twitter-image.tsx",
        "!**/app/**/sitemap.ts",
        "!**/app/**/sitemap.tsx",
        "!**/app/**/robots.ts",
        "!**/app/**/robots.tsx",
        "!**/app/**/manifest.ts",
        "!**/app/**/manifest.tsx"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "error",
            "noReExportAll": "error"
          }
        }
      },
      "plugins": ["./.biome-plugins/no-export-from.grit"]
    },
    {
      "includes": ["**/*.mjs", "**/*.cjs", "**/scripts/**", "**/.github/scripts/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnresolvedImports": "error"
          }
        }
      }
    },
    {
      "includes": ["**/apps/sdp-web/playwright/**", "scripts/**", "**/generated/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ],
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/dist",
      "!**/*.d.ts",
      "!**/pnpm-lock.yaml",
      "!**/.source",
      "!**/packages/sdp-spc-escrow/src/generated",
      "!**/packages/sdp-spc-withdraw/src/generated",
      "!**/packages/sdp-dvp/src/generated",
      "!**/packages/sdp-spc-escrow/idl",
      "!**/packages/sdp-spc-withdraw/idl",
      "!**/packages/sdp-dvp/idl",
      "!**/packages/sdp-veda/idl",
      "!**/apps/sdp-api/.earn-catalogue"
    ]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  }
}
